# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Railway Postgres — Railway dashboard → Postgres service → Connect → Public URL
DATABASE_URL=postgresql://user:password@host:port/railway

# Auth.js — generate with: pnpm dlx auth secret
AUTH_SECRET=

# Public origin of the deployment. Required behind a reverse proxy that does
# not forward the public host (Railway): without it Auth.js builds callback
# URLs from the container's own host and OAuth redirect_uri becomes
# https://localhost:8080/... Leave unset locally.
AUTH_URL=

# Discord OAuth app — https://discord.com/developers/applications
# Redirect URL: <origin>/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Google OAuth client — https://console.cloud.google.com/apis/credentials
# Redirect URL: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional — CDN base for the game-art tree (<base>/monsters/<id>.png,
# <base>/ui/frame-1..7.png, <base>/ui/{mvp,mini}.png).
# Leave unset to serve the same tree from /public/img.
NEXT_PUBLIC_IMAGE_CDN=

# Optional — email of the app owner; unlocks the /admin Dailies-template
# editor for that signed-in account. Leave unset to disable the admin surface.
SUPER_ADMIN_EMAIL=
